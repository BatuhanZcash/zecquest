# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Yayındaki site adresi (katılım linki, QR, paylaşım ve sosyal medya önizlemesi için)
NEXT_PUBLIC_SITE_URL=https://zeclearn.com

# --- Sunucu sırları (yalnızca Vercel ortamında; tarayıcıya gitmez) ---
# Gündem cron'u (vercel.json, her gün 00:00 UTC)
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# İsteğe bağlı: değer havuzları için zcashd/Zebra JSON-RPC, GitHub kota sınırı
ZCASH_RPC_URL=
GITHUB_TOKEN=
